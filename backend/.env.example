ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://javian:javian@127.0.0.1:55432/javian
CORS_ORIGINS=http://localhost:5173
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_SALT=change-me
# Set true only when running behind a trusted reverse proxy
TRUST_PROXY_HEADERS=false

# Email notification for new inquiries (off unless SMTP_HOST and NOTIFY_TO are set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
NOTIFY_TO=
NOTIFY_FROM=

# Admin page (/admin): leave empty to disable. Use a long random value.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=
